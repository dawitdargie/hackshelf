# HackShelf — Root Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit the actual .env file to Git.

# --- PostgreSQL ---
POSTGRES_DB=hackshelf
POSTGRES_USER=hackshelf
POSTGRES_PASSWORD=change_me_dev_password

# --- Backend ---
DATABASE_URL=postgres://hackshelf:change_me_dev_password@localhost:5432/hackshelf
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d
FRONTEND_URL=http://localhost:3000
PORT=8080

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080